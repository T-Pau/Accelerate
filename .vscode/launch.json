{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "xlr8: test case",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/src/xlr8",
			"cwd": "${workspaceFolder}/build/tests/sandbox_error-variable-cycle.d22tfovp7",
			"args": [
				"--create-library",
				"--target",
				"6502",
				"file.s"
			],
			"stopAtEntry": false,
			"externalConsole": false,
			"MIMode": "lldb"
		},
		{
			"name": "xlr8: create f256-microkernel library",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/src/xlr8",
			"args": [
				"--system-directory",
				"share",
				"--depfile",
				"build/share/lib/f256-microkernel.d",
				"--create-library",
				"-o",
				"build/share/lib/f256-microkernel.lib",
				"share/lib/f256-microkernel.s"
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"externalConsole": false,
			"MIMode": "lldb"
		},
		{
			"name": "xlr8: create c64 library",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/src/xlr8",
			"args": [
				"--system-directory",
				"/Users/dillo/Projects/T-Pau/Development/Accelerate/share",
				"--depfile",
				"/Users/dillo/Projects/T-Pau/Development/Accelerate/build/share/lib/c64.d",
				"--create-library",
				"-o",
				"/Users/dillo/Projects/T-Pau/Development/Accelerate/build/share/lib/c64.lib",
				"/Users/dillo/Projects/T-Pau/Development/Accelerate/share/lib/c64.s"
			],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"externalConsole": false,
			"MIMode": "lldb"
		}
	]
}