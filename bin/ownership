#!/usr/bin/env python

import enum
import re
import sys

class Relationship(enum.Enum):
    owns = 1
    owned_by = 2
    references = 3
    referenced_by = 4

def reverse_relationship(relationship: Relationship) -> Relationship:
    if relationship == Relationship.owns:
        return Relationship.owned_by
    elif relationship == Relationship.owned_by:
        return Relationship.owns
    elif relationship == Relationship.references:
        return Relationship.referenced_by
    elif relationship == Relationship.referenced_by:
        return Relationship.references
    else:
        raise ValueError(f"Unknown relationship: {relationship}")

class_start_re = re.compile(r"^\*\*(\w+)\*\*:$")
class_name_re = re.compile(r"\*\*(\w+)\*\*")
class_names_ignore_re = re.compile(r"\(.*\)")

ignored_class_names: set[str] = {
    "Body",
    "Expression",
}

class Class:
    def __init__(self, name: str):
        self.name = name
        self.raw_relationship_names: dict[Relationship, list[str]] = {
            Relationship.owns: [],
            Relationship.owned_by: [],
            Relationship.references: [],
            Relationship.referenced_by: [],
        }
        self.raw_relationships: dict[Relationship, set["Class"]] = {
            Relationship.owns: set(),
            Relationship.owned_by: set(),
            Relationship.references: set(),
            Relationship.referenced_by: set(),
        }
        self.relationships: dict[Relationship, set["Class"]] = {
            Relationship.owns: set(),
            Relationship.owned_by: set(),
            Relationship.references: set(),
            Relationship.referenced_by: set(),
        }

    def add_relationship(self, relationship: Relationship, other_class: "Class"):
        self.relationships[relationship].add(other_class)
        other_class.relationships[reverse_relationship(relationship)].add(self)

    def own(self, other: "Class"):
        self.add_relationship(Relationship.owns, other)

    def reference(self, other: "Class"):
        self.add_relationship(Relationship.references, other)

    def process_raw_relationships(self):
        for relationship, class_names in self.raw_relationship_names.items():
            for class_name in class_names:
                if class_name in classes:
                    other_class = classes[class_name]
                    self.raw_relationships[relationship].add(other_class)
                    if relationship == Relationship.owns or relationship == Relationship.references:
                        self.add_relationship(relationship, other_class)
                elif class_name not in ignored_class_names:
                    print(f"{self.name}: {relationship.name} contains unknown class {class_name}")

    def verify_raw_relationships(self):
        for relationship in Relationship:
            if self.raw_relationships[relationship] != self.relationships[relationship]:
                print(f"{self.name}: {relationship.name} wrong: computed: {[cls.name for cls in self.relationships[relationship]]}, written: {[cls.name for cls in self.raw_relationships[relationship]]}")

classes: dict[str, Class] = {}

class LineNumberedFile:
    def __init__(self, filename):
        self.filename = filename
        self.f = open(filename, "r")
        self.line_number = 0

    def readline(self) -> str:
        line = self.f.readline()
        if line:
            self.line_number += 1
        return line

    def error(self, message: str):
        print(f"{self.filename}:{self.line_number}: {message}", file=sys.stderr)

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc_value, traceback):
        self.f.close()

def class_name(word: str) -> str:
    word = word.strip()
    if (match := class_name_re.search(word)):
        return match.group(1)
    else:
        raise ValueError(f"Invalid class name: '{word}'")


def parse_class_name_list(current_class: Class, relationship: Relationship, line: str):
    name_list = []
    if line.endswith("."):
        line = line[:-1]
    if (match := class_names_ignore_re.search(line)):
        line = (line[:match.start()] + line[match.end():]).strip()
    if line != "nothing":
        name_list = [class_name(name) for name in line.split(",")]

    current_class.raw_relationship_names[relationship].extend(name_list)

def parse_class(f, current_class: Class):
    beginning = True

    while (line := f.readline()):
        try:
            line = line.strip()
            if not line:
                if beginning:
                    continue
                else:
                    break
            beginning = False
            if line.startswith("- Referenced by "):
                parse_class_name_list(current_class, Relationship.referenced_by, line[len("- Referenced by "):])
            elif line.startswith("- References "):
                parse_class_name_list(current_class, Relationship.references, line[len("- References "):])
            elif line.startswith("- Owns "):
                parse_class_name_list(current_class, Relationship.owns, line[len("- Owns "):])
            elif line.startswith("- Owned by "):
                parse_class_name_list(current_class, Relationship.owned_by, line[len("- Owned by "):])
        except Exception as e:
            f.error(f"{e}")

def main():
    if len(sys.argv) != 2:
        print("Usage: ownership <ownership_file>")
        sys.exit(1)
    ownership_file = sys.argv[1]

    with LineNumberedFile(ownership_file) as f:
        while (line := f.readline()):
            line = line.strip()
            if match := class_start_re.match(line):
                class_name = match.group(1)
                current_class = Class(class_name)
                parse_class(f, current_class)
                classes[class_name] = current_class

    for current_class in classes.values():
        current_class.process_raw_relationships()

    for current_class in classes.values():
        current_class.verify_raw_relationships()


if __name__ == "__main__":
    main()