arguments --create-library --target 6502 a.s
file a.s <inline>
.macro store value, address {
    lda #value
    sta address
}

.macro store_twice value {
    store value, $1234
    store value, $5678
}
.section code
test {
    store_twice $12
    rts
}
end-of-inline-data
file a.lib {} <inline>
.format_version 1.0
.target "6502"
.macro store {
    visibility: private
    arguments: value, address
    body <
        .scope {
            value = value
            .if .in_range($00, $ff, value) {
              .data $a9, value:1
            }
            .else {
              .error "arguments out of range" ("a.s", 2, 5, 15)
            }
        }
        .scope {
            address = address
            .if .in_range($00, $ff, address) {
              .data $85, address:1
            }
            .else_if .in_range($00, $ffff, address) {
              .data $8d, address:2
            }
            .else {
              .error "arguments out of range" ("a.s", 3, 5, 16)
            }
        }
    >
}
.macro store_twice {
    visibility: private
    arguments: value
    body <
        .scope {
            value = value
            .if .in_range($00, $ff, value) {
              .data $a9, value:1
            }
            .else {
              .error "arguments out of range" ("a.s", 2, 5, 15)
            }
        }
        .data $8d, $1234
        .scope {
            value = value
            .if .in_range($00, $ff, value) {
              .data $a9, value:1
            }
            .else {
              .error "arguments out of range" ("a.s", 2, 5, 15)
            }
        }
        .data $8d, $5678
    >
}
.object test {
    visibility: private
    section: code
    body <
        .data $a9, $12, $8d, $1234, $a9, $12, $8d, $5678, $60
    >
}
end-of-inline-data
