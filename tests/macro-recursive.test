description Test recursive macro
arguments --create-library --target 6502 a.s
return 1

file a.s <inline>
.macro multiload address, count {
    .if count > 0 {
        lda address
        multiload address, count - 1
    }
}
.section code
test {
    multiload $0400, 3
}
end-of-inline-data
stderr
a.s:1:8: error: circular definition: multiload -> multiload
.macro multiload address, count {
       ^^^^^^^^^
end-of-inline-data
