description Test recursive macro
arguments --create-library --target 6502 a.s

file a.s <inline>
.macro multiload address, count {
    .if count > 0 {
        lda address
        multiload address, count - 1
    }
}
.section code
test {
    multiload $0400, 3
}
end-of-inline-data
stderr
reference cycle detected
end-of-inline-data
