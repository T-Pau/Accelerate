description Test detection of cycle in variable definition.
arguments --create-library --target 6502 file.s
return 1

file file.s <inline>
cycle = cycle + 1
indirect_a = indirect_b + 1
indirect_b = indirect_a + 1
end-of-inline-data

stderr
file.s:1:1: error: circular definition: cycle -> cycle
cycle = cycle + 1
^^^^^
file.s:2:1: error: circular definition: indirect_a -> indirect_b -> indirect_a
indirect_a = indirect_b + 1
^^^^^^^^^^
end-of-inline-data
