arguments --create-library --target c64-basic a.s

file a.s <inline>
.macro choose value64, value128, address {
    .if .defined(C64) {
        ldx #value64
    }
    .else {
        ldx #value128
    }
    stx address
}
.section code
test {
    choose $40, $80, $4567
    rts
}
end-of-inline-data

file a.lib {} <inline>
.format_version 1.0
.target "c64-basic"
.macro choose {
    visibility: private
    arguments: value64, value128, address
    body <
        .scope {
            value = value64
            .if .in_range($00, $ff, value) {
              .data $a2, value:1
            }
            .else {
              .error "arguments out of range" ("a.s", 3, 9, 21)
            }
        }
        .scope {
            address = address
            .if .in_range($00, $ff, address) {
              .data $86, address:1
            }
            .else_if .in_range($00, $ffff, address) {
              .data $8e, address:2
            }
            .else {
              .error "arguments out of range" ("a.s", 8, 5, 16)
            }
        }
    >
}
.object test {
    visibility: private
    section: code
    body <
        .data $a2, $40, $8e, $4567, $60
    >
}
end-of-inline-data
