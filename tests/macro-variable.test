arguments --create-library --target 6502 a.s
file a.s <inline>
value = $ef
address = $1234
.macro store value {
    lda #value
    sta address
}
.section code
test {
    store $12
    rts
}
end-of-inline-data
file a.lib {} <inline>
.format_version 1.0
.target "6502"
.constant address {
    visibility: private
    value: $1234
}
.constant value {
    visibility: private
    value: $ef
}
.macro store {
    visibility: private
    arguments: value
    body <
        .scope {
            value = value
            .if .in_range(-$80, $ff, value) {
              .data $a9, value:1
            }
            .else {
              .error "arguments out of range" ("a.s", 4, 5, 15)
            }
        }
        .data $8d, $1234
    >
}
.object test {
    visibility: private
    section: code
    body <
        .data $a9, $12, $8d, $1234, $60
    >
}
end-of-inline-data
