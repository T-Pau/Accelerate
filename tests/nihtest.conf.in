[settings]
features-files = @CMAKE_BINARY_DIR@/config.h
test-input-directories = @CMAKE_CURRENT_SOURCE_DIR@
program-directories = @CMAKE_CURRENT_BINARY_DIR@
    @CMAKE_CURRENT_BINARY_DIR@/Release
    @CMAKE_CURRENT_BINARY_DIR@/Debug
    @CMAKE_BINARY_DIR@/src
    @CMAKE_BINARY_DIR@/src/Release
    @CMAKE_BINARY_DIR@/src/Debug
default-program = xlr8
# Remove directory component from error messages with program name, but not input file names
default-stderr-replace = "^[^ :]*xlr8: " ""

[environment]
XLR8_SYSTEM_DIRECTORY = @CMAKE_SOURCE_DIR@/share
XLR8_VERBOSE_ERRORS = 1
